      },
      {
        "type": "error_contains",
        "text": "unknown tool"
      }
    ]
  },
  {
    "id": "reject-oversized-plan",
    "title": "A 13-task plan exceeds the limit and is rejected",
    "request": "x",
    "plan_file": "too_many.json",
    "args": [],
    "expect": [
      {
        "type": "status",
        "is": "failed"
      },
      {
        "type": "error_contains",
        "text": "limit"
      }
    ]
  },
  {
    "id": "budget-hard-cap",
    "title": "--max-llm-calls is a hard cap and exhaustion is reported",
    "request": "Compare Rust and Go for a CLI tool",
    "args": [
      "--max-llm-calls",
      "3"
    ],
    "expect": [
      {
        "type": "metric",
        "name": "llm_calls",
        "lte": 3
      },
      {
        "type": "event_count",
        "kind": "budget_exhausted",
        "gte": 1
      },
      {
        "type": "status",
        "is": [
          "partial",
          "failed"
        ]
      }
    ]
  },
  {
    "id": "real-parallelism",
    "title": "Independent tasks overlap in time (parallelism > 1.2x)",
    "request": "Compare Rust and Go for a CLI tool",
    "args": [
      "--latency-ms",
      "150"
    ],
    "expect": [
      {
        "type": "metric",
        "name": "parallelism",
        "gte": 1.2
      }
    ]
  },
  {
