      {
        "type": "status",
        "is": "failed"
      },
      {
        "type": "error_contains",
        "text": "cycle"
      },
      {
        "type": "metric",
        "name": "llm_calls",
        "eq": 0
      }
    ]
  },
  {
    "id": "reject-dangling-dep",
    "title": "Unknown dependencies are an error, not silently dropped",
    "request": "x",
