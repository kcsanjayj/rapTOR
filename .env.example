# This project only supports offline providers: local Ollama or the simulator.
# No API keys or cloud endpoints are used.
# Force a provider: sim | ollama
# RAPTOR_PROVIDER=sim
# Pin a model installed in local Ollama (otherwise selected during setup/discovered).
# RAPTOR_MODEL=
# OLLAMA_HOST=127.0.0.1:11434
# RAPTOR_TIMEOUT_SECS=300
# RAPTOR_DATA_DIR=./data
